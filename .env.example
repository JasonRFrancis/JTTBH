# JTTBH Environment Variable Template
# =====================================
# Copy this file to .env and fill in real values:
#
#     cp .env.example .env
#
# NEVER commit .env to source control.
# The .gitignore should contain a line: .env


# ── Flask ────────────────────────────────────────────────────────────────────

# Set to 'production' on live servers, 'development' locally
FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=


# ── MySQL ────────────────────────────────────────────────────────────────────

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=jttbh
MYSQL_PASSWORD=
MYSQL_DB=jttbh


# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Obtain from https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Authorised redirect URI registered in Google Cloud Console
# Development:  http://127.0.0.1:5000/auth/oauth2callback
# Production:   https://yourdomain.com/auth/oauth2callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/oauth2callback

# Set to '1' ONLY for local development (allows HTTP OAuth flows).
# Must be absent or '0' in production.
OAUTHLIB_INSECURE_TRANSPORT=1


# ── SMTP / Email ─────────────────────────────────────────────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Address that appears in the "From" field of sent emails
SMTP_FROM=

# Administrator email address for alert notifications
ADMIN_EMAIL=
